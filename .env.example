APP_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=social_media_mgmt_aligned
# Generated by: python -m scripts.setup. Keep the old key when migrating from Express.
TOKEN_ENCRYPTION_KEY=
STORAGE_DIR=storage
MAX_UPLOAD_MB=50
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg
# development: emails saved in storage/mail; production: smtp required
MAIL_MODE=file
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=team14@example.com
# mock supports local tests only; server refuses mock in production
SOCIAL_MODE=mock
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=
META_WEBHOOK_VERIFY_TOKEN=
# Font .ttf supporting Vietnamese, required for Vietnamese PDF exports
REPORT_FONT_PATH=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_EXTRA_SCOPES=
